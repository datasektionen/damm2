{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@formkit/auto-animate": "^0.10.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "methone": "github:datasektionen/Methone#master",
    "react": "^19.3.1",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "postbuild": "mkdir -p ../dist/client && rsync -a build ../dist/client/",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write 'src/**/*.{scss,css,json}'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "methone": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
