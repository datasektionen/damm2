{
  "compilerOptions": {
    "target": "es2017",
    "allowJs": false,
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "node",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types/"],
    "esModuleInterop": true,
    "inlineSourceMap": true
  },
  "exclude": ["node_modules", "dist", "client"]
}
