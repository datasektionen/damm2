{
  "name": "damm-server",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "cp -r fuzzyfile.json prisma ./dist/",
    "setup": "npx prisma migrate deploy && npm --prefix client install",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "test": "NODE_ENV=testing mocha -r ts-node/register test/*.ts --exit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "dc:up": "docker compose -f .docker/compose/docker-compose-dev.yml up -d postgres pgadmin",
    "dc:down": "docker compose -f .docker/compose/docker-compose-dev.yml down"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "aws-sdk": "^2.1693.0",
    "cors": "^2.8.6",
    "cron": "^2.4.4",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "express-validator": "^6.15.0",
    "http-status-codes": "^2.3.0",
    "json2csv": "^5.0.7",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.4",
    "openid-client": "^5.7.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/chai": "^4.2.17",
    "@types/chai-http": "^4.2.0",
    "@types/cors": "^2.8.10",
    "@types/express": "^4.17.11",
    "@types/express-session": "^1.19.0",
    "@types/json2csv": "^5.0.3",
    "@types/mocha": "^8.2.2",
    "@types/morgan": "^1.9.2",
    "@types/multer": "^1.4.5",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "chai": "^4.3.4",
    "chai-http": "^4.3.0",
    "eslint": "^7.25.0",
    "mocha": "^8.3.2",
    "nodemon": "^2.0.7",
    "ts-node": "^5.0.1",
    "typescript": "~5.9"
  }
}
